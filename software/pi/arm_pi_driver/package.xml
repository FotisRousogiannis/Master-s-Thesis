<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_pi_driver</name>
  <version>0.1.0</version>
  <description>Raspberry Pi driver of the arm: AS5600 encoders to joint_states, servos through PCA9685 (ADR-0021).</description>
  <maintainer email="115790877+FotisRousogiannis@users.noreply.github.com">Fotis Rousogiannis</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>arm_calibration</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>i2c-tools</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
