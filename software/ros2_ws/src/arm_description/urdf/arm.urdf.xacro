<?xml version="1.0"?>
<!--
  6-DOF robotic arm - model from the Fusion 360 design (docs/decisions/0026).

  The links, meshes, joint axes and limits are generated from Fusion's URDF export by
  scripts/from_fusion.py into arm_model.xacro (never edited by hand). This file adds what the rest of
  the system needs around it: the world anchor, the tool frame and the ros2_control block.

  Zero pose: the exported pose, arm vertical. Joints are the LOGICAL joints of the arm; differential
  mechanisms are resolved by the controller (Pi / ESP32), not in the URDF. The gripper is fixed for now.
-->
<robot name="robotic_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- hardware: mock | gazebo | real (docs/decisions/0016). controllers_file: absolute path to the
       controllers YAML, needed only by the Gazebo plugin (passed by arm_bringup). -->
  <xacro:arg name="hardware" default="mock"/>
  <xacro:arg name="controllers_file" default=""/>

  <!-- Velocity: servo 300 deg/s through a 1:36 reduction ~ 8.3 deg/s (docs/BOM). Effort: not measured. -->
  <xacro:property name="joint_velocity" value="0.145"/>
  <xacro:property name="joint_effort"   value="60.0"/>

  <!-- Simulation only (Gazebo): the servos turn through a 1:36 reduction and do not back-drive, so a joint
       holds where it is without power. Modelled as joint friction; otherwise the arm falls over in the seconds
       before the controllers start and cannot lift itself again. ESTIMATES, not measured (ADR-0026). -->
  <xacro:property name="hw" value="$(arg hardware)"/>
  <xacro:property name="joint_friction" value="${10.0 if hw == 'gazebo' else 0.0}"/>
  <xacro:property name="joint_damping"  value="${1.0 if hw == 'gazebo' else 0.0}"/>

  <material name="arm_grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="arm_orange"><color rgba="0.9 0.45 0.1 1.0"/></material>

  <xacro:include filename="arm_model.xacro"/>
  <xacro:include filename="arm.ros2_control.xacro"/>

  <!-- World anchor so the model can be fixed in simulation. -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:arm_model/>

  <!-- Tool frame on the axis of joint_6 (ROS-Industrial convention: z out of the flange). The point
       between the fingers (TCP) is added with the gripper's own joints. -->
  <link name="tool0"/>
  <joint name="link_6_to_tool0" type="fixed">
    <parent link="link_6"/>
    <child link="tool0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:arm_ros2_control hardware="$(arg hardware)" controllers_file="$(arg controllers_file)"
                          joints="${['joint_1', 'joint_2', 'joint_3', 'joint_4', 'joint_5', 'joint_6']}"/>

</robot>
