<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_logbook</name>
  <version>0.1.0</version>
  <description>Logbook of the arm in SQLite: last position, calibration history, recordings, faults (ADR-0020).</description>
  <maintainer email="115790877+FotisRousogiannis@users.noreply.github.com">Fotis Rousogiannis</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
