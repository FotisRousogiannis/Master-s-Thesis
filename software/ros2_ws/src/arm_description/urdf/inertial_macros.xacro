<?xml version="1.0"?>
<!-- Inertia of simple primitives. Used until real mass properties come from CAD. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Solid cylinder along the local z axis, origin at its centre. -->
  <xacro:macro name="cylinder_inertial" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (3 * radius * radius + length * length) / 12.0}" ixy="0.0" ixz="0.0"
               iyy="${mass * (3 * radius * radius + length * length) / 12.0}" iyz="0.0"
               izz="${mass * radius * radius / 2.0}"/>
    </inertial>
  </xacro:macro>

</robot>
