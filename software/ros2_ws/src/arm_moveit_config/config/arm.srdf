<?xml version="1.0"?>
<!--
  Semantic description of the arm for MoveIt 2 (docs/decisions/0025). Written by hand, not with the
  Setup Assistant: the model is provisional (ADR-0009) and changes; this file only names things.
-->
<robot name="robotic_arm">
  <!-- The planning group: base to flange. -->
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>

  <!-- Poses by name (radians). Provisional, like the model. -->
  <group_state name="home" group="arm">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="0"/>
    <joint name="joint_3" value="0"/>
    <joint name="joint_4" value="0"/>
    <joint name="joint_5" value="0"/>
    <joint name="joint_6" value="0"/>
  </group_state>
  <group_state name="ready" group="arm">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="0.5"/>
    <joint name="joint_3" value="1.0"/>
    <joint name="joint_4" value="0"/>
    <joint name="joint_5" value="0.5"/>
    <joint name="joint_6" value="0"/>
  </group_state>

  <!-- No <end_effector> yet: it must name a group of its own (the gripper), which the model does not
       have. Pointing it at "arm" gives «Could not identify parent group» (move_group, 2026-11-24). -->
  <virtual_joint name="fixed_base" type="fixed" parent_frame="world" child_link="world"/>

  <!-- Skipped pairs (docs/decisions/0025, 0026):
       * Adjacent: neighbours along the arm, they touch at every joint by construction;
       * Rigid: the gripper is fixed to link_6 for now (its joints come later), so its parts never move against
         each other or the flange. Checked with the Fusion meshes at the zero pose (2026-11-24): these are the
         only pairs in contact. Every other pair can really collide, so it stays checked. -->
  <disable_collisions link1="base_link" link2="link_1" reason="Adjacent"/>
  <disable_collisions link1="link_1" link2="link_2" reason="Adjacent"/>
  <disable_collisions link1="link_2" link2="link_3" reason="Adjacent"/>
  <disable_collisions link1="link_3" link2="link_4" reason="Adjacent"/>
  <disable_collisions link1="link_4" link2="link_5" reason="Adjacent"/>
  <disable_collisions link1="link_5" link2="link_6" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="gripper_base" reason="Rigid"/>
  <disable_collisions link1="link_6" link2="finger_1" reason="Rigid"/>
  <disable_collisions link1="link_6" link2="finger_1_shaft_down" reason="Rigid"/>
  <disable_collisions link1="link_6" link2="finger_1_shaft_up" reason="Rigid"/>
  <disable_collisions link1="link_6" link2="finger_2" reason="Rigid"/>
  <disable_collisions link1="link_6" link2="finger_2_shaft_down" reason="Rigid"/>
  <disable_collisions link1="link_6" link2="finger_2_shaft_up" reason="Rigid"/>
  <disable_collisions link1="gripper_base" link2="finger_1" reason="Rigid"/>
  <disable_collisions link1="gripper_base" link2="finger_1_shaft_down" reason="Rigid"/>
  <disable_collisions link1="gripper_base" link2="finger_1_shaft_up" reason="Rigid"/>
  <disable_collisions link1="gripper_base" link2="finger_2" reason="Rigid"/>
  <disable_collisions link1="gripper_base" link2="finger_2_shaft_down" reason="Rigid"/>
  <disable_collisions link1="gripper_base" link2="finger_2_shaft_up" reason="Rigid"/>
  <disable_collisions link1="finger_1" link2="finger_1_shaft_down" reason="Rigid"/>
  <disable_collisions link1="finger_1" link2="finger_1_shaft_up" reason="Rigid"/>
  <disable_collisions link1="finger_1" link2="finger_2" reason="Rigid"/>
  <disable_collisions link1="finger_1" link2="finger_2_shaft_down" reason="Rigid"/>
  <disable_collisions link1="finger_1" link2="finger_2_shaft_up" reason="Rigid"/>
  <disable_collisions link1="finger_1_shaft_down" link2="finger_1_shaft_up" reason="Rigid"/>
  <disable_collisions link1="finger_1_shaft_down" link2="finger_2" reason="Rigid"/>
  <disable_collisions link1="finger_1_shaft_down" link2="finger_2_shaft_down" reason="Rigid"/>
  <disable_collisions link1="finger_1_shaft_down" link2="finger_2_shaft_up" reason="Rigid"/>
  <disable_collisions link1="finger_1_shaft_up" link2="finger_2" reason="Rigid"/>
  <disable_collisions link1="finger_1_shaft_up" link2="finger_2_shaft_down" reason="Rigid"/>
  <disable_collisions link1="finger_1_shaft_up" link2="finger_2_shaft_up" reason="Rigid"/>
  <disable_collisions link1="finger_2" link2="finger_2_shaft_down" reason="Rigid"/>
  <disable_collisions link1="finger_2" link2="finger_2_shaft_up" reason="Rigid"/>
  <disable_collisions link1="finger_2_shaft_down" link2="finger_2_shaft_up" reason="Rigid"/>
</robot>
